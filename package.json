{
  "name": "komit",
  "displayName": "Komit",
  "description": "Generate commit messages and PR descriptions from your changes, using any AI provider.",
  "icon": "assets/icon.png",
  "version": "0.4.3",
  "publisher": "ariefsn",
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ariefsn/vsce-komit"
  },
  "bugs": {
    "url": "https://github.com/ariefsn/vsce-komit/issues",
    "email": "ayiexz22@gmail.com"
  },
  "author": {
    "name": "Arief Setiyo Nugroho",
    "url": "https://github.com/ariefsn"
  },
  "maintainers": [
    {
      "name": "Arief Setiyo Nugroho",
      "email": "ayiexz22@gmail.com",
      "url": "https://github.com/ariefsn"
    }
  ],
  "categories": [
    "SCM Providers",
    "Machine Learning"
  ],
  "keywords": [
    "komit",
    "commit",
    "commit-message",
    "git",
    "ai",
    "conventional-commits",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "openrouter",
    "ollama",
    "lmstudio",
    "groq",
    "deepseek",
    "qwen",
    "glm",
    "zhipu",
    "sumopod",
    "vscodium",
    "source-control",
    "pull-request",
    "pr-description"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, Komit ignores workspace-level provider settings and repository-local instruction files, and will not run CLI-based providers.",
      "restrictedConfigurations": [
        "komit.providers",
        "komit.activeProvider",
        "komit.prompt",
        "komit.excludeGlobs",
        "komit.excludeGlobs.additional",
        "komit.includeGlobs",
        "komit.signature",
        "komit.conventionalCommits",
        "komit.commitTypes",
        "komit.bodyStyle",
        "komit.scopeSource",
        "komit.ticketPattern",
        "komit.ticketUppercase",
        "komit.privacyNotice",
        "komit.baseBranch",
        "komit.prPrompt",
        "komit.maxPrDiffBytes",
        "komit.limits.bodyBullets",
        "komit.limits.prSummaryBullets",
        "komit.limits.prChangesBullets",
        "komit.limits.bulletChars",
        "komit.limits.subjectChars"
      ]
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "komit.generate",
        "title": "Generate Commit Message",
        "category": "Komit",
        "enablement": "komit.hasStagedChanges",
        "icon": "$(git-commit)"
      },
      {
        "command": "komit.regenerate",
        "title": "Regenerate Commit Message",
        "category": "Komit",
        "enablement": "komit.hasStagedChanges"
      },
      {
        "command": "komit.generatePr",
        "title": "Generate PR Description",
        "category": "Komit"
      },
      {
        "command": "komit.selectProvider",
        "title": "Select Provider",
        "category": "Komit"
      },
      {
        "command": "komit.selectModel",
        "title": "Select Model",
        "category": "Komit"
      },
      {
        "command": "komit.editPrompt",
        "title": "Edit Prompt",
        "category": "Komit"
      },
      {
        "command": "komit.editSignature",
        "title": "Edit Signature",
        "category": "Komit"
      },
      {
        "command": "komit.configure",
        "title": "Configure",
        "category": "Komit"
      },
      {
        "command": "komit.openSettings",
        "title": "Open Settings",
        "category": "Komit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "komit.generate",
          "group": "navigation@-1",
          "when": "scmProvider == git"
        }
      ],
      "git.commit": [
        {
          "command": "komit.generate",
          "group": "4_komit@1",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Komit",
      "properties": {
        "komit.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "Configured providers. Add these with **Komit: Select Provider** rather than by hand. API keys are stored in the OS keychain and never appear here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this profile."
              },
              "label": {
                "type": "string",
                "description": "Name shown in the picker."
              },
              "type": {
                "type": "string",
                "enum": [
                  "cli",
                  "openai",
                  "anthropic"
                ],
                "description": "Provider class."
              },
              "model": {
                "type": "string",
                "description": "Model identifier."
              },
              "command": {
                "type": "string",
                "description": "cli only: the binary to run."
              },
              "promptArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "cli only: arguments that put the binary into single-prompt mode."
              },
              "extraArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "cli only: additional arguments."
              },
              "baseUrl": {
                "type": "string",
                "description": "openai/anthropic only: API base URL."
              }
            }
          }
        },
        "komit.activeProvider": {
          "type": "string",
          "default": "",
          "description": "Id of the profile currently in use."
        },
        "komit.conventionalCommits": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Require a `type(scope): summary` subject. Turn off to match the style of the repository's existing commits instead."
        },
        "komit.commitTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "feat",
            "fix",
            "docs",
            "style",
            "refactor",
            "perf",
            "test",
            "build",
            "ci",
            "chore",
            "revert"
          ],
          "markdownDescription": "Allowed commit types. The defaults are the Conventional Commits set. Add your own, `hotfix` for example, if your team uses them, but note that commit linters may reject non-standard types."
        },
        "komit.bodyStyle": {
          "type": "string",
          "enum": [
            "bullets",
            "prose",
            "none"
          ],
          "enumDescriptions": [
            "2-4 short bullet points",
            "One short paragraph",
            "Subject line only"
          ],
          "default": "bullets",
          "description": "Shape of the message body below the subject line."
        },
        "komit.scopeSource": {
          "type": "string",
          "enum": [
            "auto",
            "ticket",
            "path",
            "none"
          ],
          "enumDescriptions": [
            "Ticket key from the branch when there is one, otherwise the code area",
            "Ticket key only, with no scope when the branch has none",
            "Always derive the scope from the changed files",
            "Never include a scope"
          ],
          "default": "auto",
          "markdownDescription": "Where the scope in `type(scope):` comes from."
        },
        "komit.ticketPattern": {
          "type": "string",
          "default": "[A-Za-z]{2,}[A-Za-z0-9]*-\\d+",
          "markdownDescription": "Regular expression matched against the branch name to find a ticket key. The default matches Jira and Linear style keys such as `PAP-51` in `feat/PAP-51-add-login`. It requires two leading letters so branches like `release/v2-1` are not mistaken for tickets."
        },
        "komit.ticketUppercase": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Uppercase the extracted key, so `feat/pap-51` still yields `PAP-51` and one ticket never appears two ways in history."
        },
        "komit.privacyNotice": {
          "type": "string",
          "enum": [
            "once",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Confirm once per provider",
            "Confirm every time",
            "Never confirm"
          ],
          "default": "once",
          "description": "How often to confirm before your staged diff is sent to a provider."
        },
        "komit.limits.bodyBullets": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 2,
          "default": [
            2,
            4
          ],
          "markdownDescription": "How many bullets in a commit body. `[2, 4]` asks for two to four. Use `[1]` for exactly one."
        },
        "komit.limits.prSummaryBullets": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 2,
          "default": [
            1,
            2
          ],
          "markdownDescription": "How many bullets in the PR Summary section."
        },
        "komit.limits.prChangesBullets": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 2,
          "default": [
            3,
            6
          ],
          "markdownDescription": "How many bullets in the PR Changes section. Keeping this small is what stops long branches producing one bullet per file."
        },
        "komit.limits.bulletChars": {
          "type": "number",
          "minimum": 20,
          "default": 120,
          "description": "Rough character limit for a single bullet."
        },
        "komit.limits.subjectChars": {
          "type": "number",
          "minimum": 20,
          "default": 72,
          "description": "Character limit for the commit subject line. 72 is the git convention."
        },
        "komit.signature": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Git trailers appended to every message, such as `Co-authored-by: Name <you@example.com>`. They are added after generation so the text is exact, and template variables like `{{branch}}` work. Edit them with **Komit: Edit Signature**."
        },
        "komit.prompt": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Override the built-in prompt. Supports `{{diff}}`, `{{stat}}`, `{{recentCommits}}`, `{{branch}}`, `{{userHint}}`, `{{language}}`, `{{ticket}}` and `{{styleRules}}`. A repository's `.komit.md` takes precedence over this. A template that leaves out `{{styleRules}}` also overrides the style settings above."
        },
        "komit.language": {
          "type": "string",
          "default": "English",
          "description": "Language the commit message is written in."
        },
        "komit.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Branch that pull requests target. Leave it empty to detect it from `origin/HEAD`, then `main`, `master` or `develop`."
        },
        "komit.prPrompt": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Override the PR description template. Supports the same variables plus `{{commits}}` and `{{base}}`. A repository's `.komit-pr.md`, or its `.github/pull_request_template.md`, takes precedence over this."
        },
        "komit.maxPrDiffBytes": {
          "type": "number",
          "default": 120000,
          "description": "Diff budget for PR descriptions. It is larger than the commit budget because a branch diff spans many commits."
        },
        "komit.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Paths excluded from the diff before it is sent. This replaces the built-in list. To extend it instead, use `#komit.excludeGlobs.additional#`.",
          "default": [
            "**/.env",
            "**/.env.*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/*.keystore",
            "**/*.jks",
            "**/id_rsa",
            "**/id_ed25519",
            "**/*.lock",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/bun.lockb",
            "**/go.sum",
            "**/Cargo.lock",
            "**/composer.lock",
            "**/Gemfile.lock",
            "**/poetry.lock",
            "**/Pipfile.lock",
            "**/uv.lock",
            "**/pubspec.lock",
            "**/mix.lock",
            "**/Podfile.lock",
            "**/gradle.lockfile",
            "**/packages.lock.json",
            "**/*.pb.go",
            "**/*_pb2.py",
            "**/*_pb2_grpc.py",
            "**/*.pb.cc",
            "**/*.pb.h",
            "**/*_pb.js",
            "**/*_pb.d.ts",
            "**/*.pb.dart",
            "**/*_gen.go",
            "**/*_generated.go",
            "**/wire_gen.go",
            "**/*.g.dart",
            "**/*.freezed.dart",
            "**/*.g.cs",
            "**/*.designer.cs",
            "**/*.generated.*",
            "**/__generated__/**",
            "**/generated/**",
            "**/build/generated/**",
            "**/R.java",
            "**/BuildConfig.java",
            "**/*_Impl.java",
            "**/gradle/wrapper/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/bin/**",
            "**/obj/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.svelte-kit/**",
            "**/.output/**",
            "**/.turbo/**",
            "**/coverage/**",
            "**/vendor/**",
            "**/node_modules/**",
            "**/Pods/**",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.min.*",
            "**/*.map",
            "**/__snapshots__/**",
            "**/*.snap",
            "**/*.golden"
          ]
        },
        "komit.excludeGlobs.additional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra exclusions appended to the built-in list, so one project-specific pattern does not require copying the whole default array."
        },
        "komit.includeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env.example",
            "**/.env.sample",
            "**/.env.template",
            "**/.env.dist"
          ],
          "markdownDescription": "Paths sent even though `#komit.excludeGlobs#` matches them. Git pathspec cannot re-include an excluded path, so these come from a second diff pass. That is how `.env` stays out while `.env.example` still reaches the model."
        },
        "komit.recentCommitCount": {
          "type": "number",
          "default": 10,
          "description": "How many recent commit subjects to send, so the message matches the repository's existing style."
        },
        "komit.maxDiffBytes": {
          "type": "number",
          "default": 60000,
          "description": "Byte budget for the diff. The file summary is always sent in full."
        },
        "komit.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "description": "How long to wait for the provider before giving up."
        },
        "komit.overwriteExistingMessage": {
          "type": "boolean",
          "default": false,
          "description": "Discard text already in the commit box instead of treating it as intent to refine."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "yarn run package && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --packagePath komit-$npm_package_version.vsix",
    "publish:ovsx": "ovsx publish komit-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "resolutions": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
